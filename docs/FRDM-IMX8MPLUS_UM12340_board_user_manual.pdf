         <pdf:Keywords>UM12340, FRDM-IMX8MPLUS, i.MX 8M Plus applications processor, FRDM-IMX8MPLUS board, block diagram, board interfaces</pdf:Keywords>
         <pdf:Producer>Apache FOP Version 2.8</pdf:Producer>
